{
  "name": "permet-score",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern qa-screenshots",
    "qa": "npm run qa:routes && npm run qa:visual",
    "qa:routes": "node scripts/route-timing.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "data:sync:tcgplayer": "node scripts/sync-tcgplayer.mjs",
    "data:check:tcgplayer": "node scripts/sync-tcgplayer.mjs --check",
    "perf:lighthouse": "npx lighthouse@latest http://localhost:3000 --output=html --output-path=./qa-screenshots/lighthouse.html --only-categories=performance,accessibility,best-practices,seo --chrome-flags='--headless=new'",
    "analyze": "next experimental-analyze --output"
  },
  "dependencies": {
    "@vercel/blob": "^2.5.0",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
